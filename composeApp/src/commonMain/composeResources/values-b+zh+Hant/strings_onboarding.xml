<resources>
    <string name="onboarding_title">歡迎使用 Arkiroku</string>
    <string name="onboarding_step_counter">第 %1$d / %2$d 步</string>
    <string name="onboarding_step_language_title">語言與外觀</string>
    <string name="onboarding_step_language_message">您可以在這裡選擇語言，並自訂您喜歡的外觀。</string>
    <string name="onboarding_appearance_theme">深色模式</string>
    <string name="onboarding_appearance_haze">毛玻璃效果</string>
    <string name="onboarding_appearance_preview">預覽</string>
    <string name="onboarding_api_section_title">查分 API（可選）</string>
    <string name="onboarding_api_section_desc">如果您想要取得來自社群的查分資料，則您可以在這裡設定您的 API 資訊，之後可以在設定裡更改。\n您也可以在不使用查分 API 的情況下使用 Arkiroku。\n\n要確定您的平台名稱、平台 ID 與 API 使用者 ID，請向任何一個正在使用 Phi-Plugin 的機器人發送 /tkls 指令和 /sessiontoken 指令以確定。\n\n參與譜面標籤投票還需要 API Token，請向任意 Phi-Plugin 機器人發送 /setApiToken &lt;自訂Token> 以設定，然後將 Token 填入上方。Token 僅用於查分 API 鑑權，我們不會上傳您的 sessionToken。</string>
    <string name="onboarding_step_b30_title">B30 圖片樣式</string>
    <string name="onboarding_step_b30_message">您可以在這裡選擇您喜歡的 B30 曲目卡片樣式，也可以在 B30 圖片預覽頁面裡更改。</string>
    <string name="onboarding_b30_preview_unavailable">我們沒有足夠的資料來確定您的 B30，請先進行幾次遊戲並同步雲端存檔後重試。</string>
    <string name="onboarding_step_login_title">登入 TapTap</string>
    <string name="onboarding_step_login_message">您可以在這裡登入您的 TapTap 帳號，我們會在登入後自動同步您的雲端存檔。如果不想登入 TapTap，您也可以點擊下方的「暫不登入，先逛逛」跳過。</string>
    <string name="onboarding_login_guest">暫不登入，先逛逛</string>
    <string name="onboarding_step_preload_title">曲繪縮圖</string>
    <string name="onboarding_step_preload_message">您可以在這裡下載曲繪縮圖以獲得更好的體驗，您也可以之後在設定裡再次下載。</string>
    <string name="onboarding_preload_download">立即下載</string>
    <string name="onboarding_preload_skip">以後再說</string>
